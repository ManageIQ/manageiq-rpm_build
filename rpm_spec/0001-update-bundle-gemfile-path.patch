Subject: [PATCH] Update gemfile location

---
 manageiq-appliance-21.0.0/COPY/etc/default/manageiq.properties | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/manageiq-appliance-21.0.0/COPY/etc/default/manageiq.properties b/manageiq-appliance-21.0.0/COPY/etc/default/manageiq.properties
index 13d6737..7fe069f 100644
