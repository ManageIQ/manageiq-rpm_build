+++ b/manageiq-appliance-21.0.0/COPY/etc/default/manageiq.properties
@@ -6,7 +6,7 @@ EXECJS_RUNTIME=Node
 MALLOC_ARENA_MAX=1
 # Location of certificates and provider keys (miq-password and appliance console)
 KEY_ROOT=/var/www/miq/vmdb/certs
-BUNDLE_GEMFILE=/var/www/miq/vmdb/Gemfile
+BUNDLE_GEMFILE=/usr/lib/manageiq/manageiq/Gemfile
 
 # Force locale
 LANGUAGE=en_US.UTF-8
